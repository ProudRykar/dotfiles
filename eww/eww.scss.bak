* {
    background-color: transparent;
}

window {
    background: transparent;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    box-shadow: none;
}

.scourge-content {
    background: transparent;
    background-color: rgba(0, 0, 0, 0);
    padding: 110px 126px 88px 126px;
}

.search-input {
    min-height: 38px;
    padding: 0 18px;
    color: #efe7c0;
    caret-color: #a9d65a;
    background-color: rgba(15, 13, 19, 0.85);
    border: 1px solid #51465c;
    border-radius: 0;
}

.app-list {
    margin-top: 8px;
    background-color: transparent;
}

.entry-row {
    min-height: 48px;
    padding: 5px 12px;
    color: #c8c0a5;
    background-color: rgba(23, 19, 30, 0.9);
    border: 1px solid rgba(111, 99, 125, 0.4);
}

.entry-text {
    color: #c8c0a5;
    font-weight: bold;
    text-shadow: 0 1px 2px #000000;
    background-color: transparent;
    min-height: 100px;
}
